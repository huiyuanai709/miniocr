<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MiniOcr.ClusterBench</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishAot>false</PublishAot>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\Services\ClusterPageScheduler.cs" Link="ClusterPageScheduler.cs" />
    <Compile Include="..\..\Services\ClusterPdfRange.cs" Link="ClusterPdfRange.cs" />
    <Compile Include="..\..\Services\ParallelPdfDownloader.cs" Link="ParallelPdfDownloader.cs" />
    <Compile Include="..\..\Services\RentedBuffer.cs" Link="RentedBuffer.cs" />
  </ItemGroup>

</Project>
