<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>MiniOcr.PdfRangeSmoke</RootNamespace>
    <IsPackable>false</IsPackable>
    <PublishAot>false</PublishAot>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.0" />
    <ProjectReference Include="..\..\external\PDFtoImage\src\PDFtoImage\PDFtoImage.csproj" />
    <Compile Include="..\..\Services\ParallelPdfDownloader.cs" Link="ParallelPdfDownloader.cs" />
    <Compile Include="..\..\Services\PdfRemoteDocument.cs" Link="PdfRemoteDocument.cs" />
    <Compile Include="..\..\Services\RentedBuffer.cs" Link="RentedBuffer.cs" />
    <Compile Include="..\..\Services\PdfPageSpan.cs" Link="PdfPageSpan.cs" />
  </ItemGroup>

</Project>
