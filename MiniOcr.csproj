<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>MiniOcr</RootNamespace>
    <NoWarn>$(NoWarn);CA1416;IL2026;IL3050</NoWarn>

    <!-- Native AOT. ILC bakes the CPU instruction set in at compile time (it does not
         dispatch at run time), so SimdPaddleOCR's AVX2 / AVX-512 / VNNI kernels only
         exist when the matching tier is listed here. x64 default = avx2 (Haswell+);
         raise it per host, e.g. -p:IlcInstructionSet=avx512v2. Leaving it empty falls
         back to the SSE2 baseline and trims every AVX2/AVX-512 kernel.
         ARM64 must NOT set avx2 (baseline already includes NEON). -->
    <PublishAot>true</PublishAot>
    <IlcInstructionSet Condition="'$(IlcInstructionSet)' == '' and $([System.String]::Copy('$(RuntimeIdentifier)').Contains('x64'))">avx2</IlcInstructionSet>
    <OptimizationPreference>Speed</OptimizationPreference>
    <InvariantGlobalization>false</InvariantGlobalization>
    <StripSymbols>true</StripSymbols>
    <!-- external/ holds the SimdPaddleOCR and PDFtoImage submodules. The Web SDK
         would otherwise compile and publish every file under them alongside this project. -->
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**;artifacts/**;dist/**;.github/**;external/**</DefaultItemExcludes>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
  </PropertyGroup>

  <!-- Opt into runtime async: emit calls into the runtime's async machinery
       (System.Runtime.CompilerServices.AsyncHelpers) instead of the compiler's
       generated state machines. Preview feature; verify under Native AOT. -->
  <PropertyGroup>
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>

  <!-- Optional true single-file bundle (NOT AOT): embeds libSkiaSharp / libpdfium and
       extracts them on first run under $HOME/.net/MiniOcr/. Competition default stays AOT. -->
  <PropertyGroup Condition="'$(MiniOcrSingleFile)' == 'true'">
    <PublishAot>false</PublishAot>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>

  <ItemGroup>
    <!-- Pinned fork master @ 68e30fe (PDFtoImage Gray8 PdfPixels, PrewarmAsync,
         ShareSourceFile/RetainDocuments/NativeGrayscale, net11.0 runtime-async).
         Native PDFium / SkiaSharp assets flow as runtime assets of the core project
         (runtimes/<rid>/native); .NET copies them on publish the same way a
         PackageReference to the PDFtoImage nupkg did. Parallel re-launches this
         executable as a worker (CoreCLR startup hook, Native AOT module initializer). -->
    <ProjectReference Include="external/PDFtoImage/src/PDFtoImage/PDFtoImage.csproj" />
    <ProjectReference Include="external/PDFtoImage/src/Parallel/Parallel.csproj" />
    <!-- Pinned fork branch cursor/metal-ocr-backend-08b9 @ f574915 (merged Vulkan
         arena cap, plus Metal working-set cap and AOT-preserved .metal shaders).
         ChineseV6Small models come from the same tree. Default backend stays CPU. -->
    <ProjectReference Include="external/SimdPaddleOCR/src/Sdcb.SimdPaddleOCR/Sdcb.SimdPaddleOCR.csproj" />
    <ProjectReference Include="external/SimdPaddleOCR/src/models/Sdcb.SimdPaddleOCR.Models.ChineseV6Small/Sdcb.SimdPaddleOCR.Models.ChineseV6Small.csproj" />
  </ItemGroup>

  <Target Name="EnsureSimdPaddleOcrSubmodule" BeforeTargets="Restore;Build;Publish">
    <Error
      Condition="!Exists('$(MSBuildThisFileDirectory)external/SimdPaddleOCR/src/Sdcb.SimdPaddleOCR/Sdcb.SimdPaddleOCR.csproj')"
      Text="Missing external/SimdPaddleOCR. From the repo root run: git submodule update --init --recursive" />
  </Target>

  <Target Name="EnsurePdfToImageSubmodule" BeforeTargets="Restore;Build;Publish">
    <Error
      Condition="!Exists('$(MSBuildThisFileDirectory)external/PDFtoImage/src/PDFtoImage/PDFtoImage.csproj') or !Exists('$(MSBuildThisFileDirectory)external/PDFtoImage/src/Parallel/Parallel.csproj')"
      Text="Missing external/PDFtoImage. From the repo root run: git submodule update --init --recursive" />
  </Target>

  <!-- PublishTrimmed turns CoreCLR startup hooks off. PDFtoImage.Parallel needs
       the hook so a single-file worker enters before Main. Native AOT uses the
       module initializer instead; this import does not change that path. -->
  <Import Project="external/PDFtoImage/src/Parallel/PDFtoImage.Parallel.targets" />

  <ItemGroup>
    <!-- Keep model / Skia / PDFium assemblies from being trimmed away -->
    <TrimmerRootAssembly Include="Sdcb.SimdPaddleOCR" />
    <TrimmerRootAssembly Include="Sdcb.SimdPaddleOCR.Models.ChineseV6Small" />
    <TrimmerRootAssembly Include="Sdcb.SimdPaddleOCR.Models.TextLineOrientation" />
    <TrimmerRootAssembly Include="Sdcb.SimdPaddleOCR.ModelProvider" />
    <TrimmerRootAssembly Include="PDFtoImage" />
    <TrimmerRootAssembly Include="PDFtoImage.Parallel" />
    <TrimmerRootAssembly Include="SkiaSharp" />
  </ItemGroup>

  <ItemGroup>
    <!-- Sidecar sample is fine for AOT zip; omit for single-file so the publish dir is one binary -->
    <None Include="samples/sample-multipage.pdf" CopyToOutputDirectory="PreserveNewest" Condition="'$(MiniOcrSingleFile)' != 'true'" />
  </ItemGroup>

</Project>
