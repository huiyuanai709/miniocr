# Copy to .env next to docker-compose.yml. Do not commit .env.
# These two values are injected as environment variables and override config.docker.json.

MINIOCR_LLM_API_KEY=
MINIOCR_CLUSTER_TOKEN=

# OCR trace is on unless set to 0/off. JSONL of file URLs and per-page OCR text.
# Default path is ocr-trace.jsonl next to config.json. Do not point every replica at one file.
# MINIOCR_OCR_TRACE=0
# MINIOCR_OCR_TRACE_PATH=
# MINIOCR_OCR_TRACE_MAX_CHARS=8192

# Contest PDFs already on disk. Empty (default) keeps URL download.
# Set on every process that should open the files in place. The directory is read-only.
# MINIOCR_CHALLENGE_RESOURCE_DIR=/home/deploy/resource
